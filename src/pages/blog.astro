---
import Base from "../layouts/Base.astro";
import { getPosts, formatDate, readingMinutes, coverUrl } from "../lib/blog.js";
const posts = await getPosts();
const hasPosts = posts.length > 0;
---
<Base title="المدونة — عمر الحردان" desc="مقالات وأفكار عن الأعمال والاستراتيجية والتقنية والاقتصاد." page="blog">
<main>

<section class="page-hero">
  <div class="glow"></div>
  <div class="grid-bg"></div>
  <div class="container">
    {hasPosts ? <span class="tag" data-reveal data-i18n="b.tag2">المدونة</span> : <span class="tag" data-reveal data-i18n="b.tag">المدونة · قريباً</span>}
    <h1 class="h1 grad" data-reveal style="--d:.08s" data-i18n="b.title">أفكار تحتاج <span class="accent">مساحة أطول</span></h1>
    <p class="lead" data-reveal style="--d:.16s" data-i18n="b.lead">مقالات عن الأعمال والاستراتيجية والتقنية والاقتصاد، ودراسات حالة عن شركات نجحت وأخرى فشلت.</p>
  </div>
</section>

{hasPosts && (
<section class="section" style="padding-top:8px;padding-bottom:40px">
  <div class="container">
    <div class="posts">
      {posts.map((post, i) => (
        <a class="card post-card" href={"blog/" + post.id + ".html"} lang={post.data.lang} dir={post.data.lang === "ar" ? "rtl" : "ltr"} data-reveal style={"--d:" + (i % 3) * 0.08 + "s"}>
          <div class="post-cover">
            {post.data.cover ? <img src={coverUrl(post.data.cover, "")} alt="" loading="lazy" /> : <div class="grid-bg"></div>}
          </div>
          <div class="post-body">
            <div class="post-meta"><span>{formatDate(post.data.date, post.data.lang)}</span><span>·</span><span>{readingMinutes(post.body, post.data.lang)}</span></div>
            <h3 class="h3">{post.data.title}</h3>
            {post.data.description && <p>{post.data.description}</p>}
            <span class="post-more">{post.data.lang === "ar" ? "اقرأ المقال" : "Read the essay"} <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}
<section class="section" style="padding-top:8px">

  <div class="container">
    <div class="soon glass" data-reveal>
      <div class="icon-box" style="margin-inline:auto"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.86.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.85z"/></svg></div>
      <div class="topics">
        <span class="chip" data-i18n="b.t1">الاستراتيجية</span>
        <span class="chip" data-i18n="b.t2">الذكاء الاصطناعي والعمل</span>
        <span class="chip" data-i18n="b.t3">قصص فشل الشركات</span>
        <span class="chip" data-i18n="b.t4">الاقتصاد والتنمية</span>
        <span class="chip" data-i18n="b.t5">التحول الرقمي</span>
      </div>
      {hasPosts ? <p class="lead" data-i18n="b.notify2">اكتب بريدك لتصلك المقالات الجديدة عند نشرها.</p> : <p class="lead" data-i18n="b.notify">اكتب بريدك لتصلك أول المقالات عند نشرها.</p>}
      <form class="form" name="blog" method="POST" data-lead-form="blog">
        <input type="hidden" name="form-name" value="blog">
        <input type="hidden" name="lang" value="ar">
        <p class="hp"><label>Company <input name="company" tabindex="-1" autocomplete="off"></label></p>
        <div class="form-fields">
          <div class="field"><input class="input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" dir="ltr" aria-label="Email"></div>
          <button class="btn btn-primary" type="submit" style="margin-top:6px"><span data-i18n="b.cta">أبلغني عند النشر</span><span class="btn-ico"><svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></button>
          <p class="form-status" role="status"></p>
        </div>
        <div class="form-success"><p data-i18n="b.done">شكراً! سأراسلك عند نشر أول مقال.</p></div>
      </form>
    </div>
    <div class="videos-foot">
      <a class="btn btn-ghost" href="videos.html" data-i18n="b.watch">شاهد الفيديوهات</a>
      <a class="btn btn-ghost" href="index.html#guide" data-i18n="b.guide">حمّل الدليل المجاني</a>
    </div>
  </div>

</section>
</main>
</Base>
