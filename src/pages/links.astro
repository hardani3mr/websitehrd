---
import Base from "../layouts/Base.astro";
---
<Base title="روابط — عمر الحردان" desc="كل روابط عمر الحردان في مكان واحد: الكورس، الدليل المجاني، الفيديوهات، وحجز محادثة." page="links" chrome={false}>

<main class="links-page">
  <div class="glow g1"></div>
  <div class="grid-bg"></div>
  <div class="links-wrap">
    <div class="links-top">
      <a class="brand" href="index.html"><svg class="brand-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" aria-hidden="true"><rect x="2" y="15" width="11" height="11" rx="3" fill="#fff"/><rect x="15" y="15" width="11" height="11" rx="3" fill="#fff" fill-opacity=".55"/><rect x="2" y="2" width="11" height="11" rx="3" fill="#fff" fill-opacity=".28"/><rect x="15.6" y="2.6" width="9.8" height="9.8" rx="2.6" fill="none" stroke="#fff" stroke-opacity=".75" stroke-width="1.2"/></svg></a>
      <button class="lang-btn" type="button" data-lang-toggle aria-label="Switch language / تغيير اللغة"><span class="lang-label">EN</span></button>
    </div>

    <div class="avatar glass" data-reveal>
      <picture><source srcset="assets/img/portrait.webp" type="image/webp"><img src="assets/img/portrait.jpg" width="480" height="480" alt="عمر الحردان" data-i18n-alt="hero.alt"></picture>
    </div>
    <h1 class="name" data-reveal style="--d:.06s" data-i18n="brand">عمر الحردان</h1>
    <p class="bio" data-reveal style="--d:.12s" data-i18n="l.bio">الأعمال، والاستراتيجية، والتقنية، والاقتصاد. أبني، وأتعلّم، وأشارك.</p>
    <div class="socials" data-reveal style="--d:.18s">
      <a class="social" data-social="linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13M7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0"/></svg></a>
      <a class="social" data-social="youtube" href="#" target="_blank" rel="noopener" aria-label="YouTube"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg></a>
      <a class="social" data-social="instagram" href="#" target="_blank" rel="noopener" aria-label="Instagram"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r=".9" fill="currentColor" stroke="none"/></svg></a>
      <a class="social" data-social="facebook" href="#" target="_blank" rel="noopener" aria-label="Facebook"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07"/></svg></a>
      <a class="social" data-mail href="#" aria-label="Email"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></a>
    </div>

    <nav class="link-list">
      <a class="link-item featured" data-link="udemyUrl" href="#" target="_blank" rel="noopener" data-reveal style="--d:.22s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 7.75a.75.75 0 0 1 1.14-.64l4.17 2.5a.75.75 0 0 1 0 1.28l-4.17 2.5A.75.75 0 0 1 10 12.75z"/><path d="M12 17v4M8 21h8"/><rect x="2" y="3" width="20" height="14" rx="2"/></svg></span>
        <span class="t"><b data-i18n="l.1.t">الكورس المجاني: مقدمة إلى التحول الرقمي</b><span data-i18n="l.1.d">على Udemy · بالعربية · 5 دروس</span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
      <a class="link-item glass" href="index.html#guide" data-reveal style="--d:.26s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8M16 17H8M10 9H8"/></svg></span>
        <span class="t"><b data-i18n="l.2.t">دليل التحول الرقمي (PDF)</b><span data-i18n="l.2.d">مجاني · حمّله الآن</span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a class="link-item glass" data-cal-link href="#" target="_blank" rel="noopener" data-reveal style="--d:.3s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
        <span class="t"><b data-i18n="l.3.t">احجز محادثة لمدة ٣٠ دقيقة</b><span data-i18n="l.3.d">عبر الإنترنت · بالعربية أو الإنجليزية</span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
      <a class="link-item glass" href="videos.html" data-reveal style="--d:.34s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 13 5.22 3.48a.5.5 0 0 0 .78-.42V7.87a.5.5 0 0 0-.75-.43L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg></span>
        <span class="t"><b data-i18n="l.4.t">أحدث الفيديوهات</b><span data-i18n="l.4.d">قصص الشركات وما نتعلّمه منها</span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a class="link-item glass" href="index.html" data-reveal style="--d:.38s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>
        <span class="t"><b data-i18n="l.5.t">الموقع الشخصي</b><span>omarhardani.com</span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a class="link-item glass soon-item" href="blog.html" data-reveal style="--d:.42s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.86.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.85z"/></svg></span>
        <span class="t"><b data-i18n="l.6.t">المدونة</b><span data-i18n="l.6.d">قريباً</span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a class="link-item glass" data-mail href="#" data-reveal style="--d:.46s">
        <span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
        <span class="t"><b data-i18n="l.7.t">راسلني</b><span class="ltr" data-mail-text></span></span>
        <svg class="i-dir" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    </nav>
    <p class="links-foot">© <span data-year>2026</span> <span data-i18n="brand">عمر الحردان</span></p>
  </div>
</main>

</Base>
