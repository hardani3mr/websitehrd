---
import Base from "../layouts/Base.astro";
---
<Base title="أحدث الفيديوهات — عمر الحردان" desc="مقاطع قصيرة عن الأعمال والتقنية، ولماذا تنجح الشركات أو تفشل." page="videos">

<main class="videos-page">
<section class="page-hero">
  <div class="glow"></div>
  <div class="dots-bg d2" style="top:0;left:50%;transform:translateX(-50%);width:900px;height:160px;opacity:.5;-webkit-mask-image:radial-gradient(closest-side,#000,transparent);mask-image:radial-gradient(closest-side,#000,transparent)"></div>
  <div class="container">
    <span class="tag" data-reveal data-i18n="v.tag">أحدث الفيديوهات</span>
    <h1 class="h1 grad" data-reveal style="--d:.08s" data-i18n="vp.title">قصص الشركات… <span class="accent">وما نتعلّمه منها</span></h1>
    <p class="lead" data-reveal style="--d:.16s" data-i18n="vp.lead">لماذا تنجح الشركات أو تفشل؟ مقاطع قصيرة عن الأعمال والتقنية والإدارة، تُنشر باستمرار على يوتيوب.</p>
    <div class="hero-ctas" data-reveal style="--d:.24s">
      <a class="btn btn-primary" data-social="youtube" href="#" target="_blank" rel="noopener"><span data-i18n="v.sub">اشترك في القناة</span><span class="btn-ico"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg></span></a>
    </div>
  </div>
</section>
<section class="section" style="padding-top:24px">
  <div class="container">
    <div class="tabs" data-video-tabs hidden>
      <button type="button" class="on" data-tab="long" data-i18n="v.tab.long">الفيديوهات</button>
      <button type="button" data-tab="shorts" data-i18n="v.tab.shorts">المقاطع القصيرة</button>
    </div>
    <div class="vids" data-longs data-page-size="12" hidden></div>
    <div class="shorts" data-shorts data-page-size="20">
      <div class="short skeleton"></div><div class="short skeleton"></div><div class="short skeleton"></div><div class="short skeleton"></div>
      <div class="short skeleton"></div><div class="short skeleton"></div><div class="short skeleton"></div><div class="short skeleton"></div>
    </div>
    <div class="videos-foot">
      <a class="btn btn-ghost" data-social="youtube" href="#" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg><span data-i18n="vp.more">المزيد على يوتيوب</span></a>
    </div>
  </div>
</section>
</main>

</Base>
